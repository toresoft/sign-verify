<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.toresoft</groupId>
    <artifactId>sign-verify-2</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <licenses>
        <license>
            <name>GNU Lesser General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/lgpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Override transitive TEST-scope deps flagged by Dependabot (test-only, never shipped):
             commons-compress (via Testcontainers) — CVE-2024-25710 (DUMP infinite-loop DoS) and
             CVE-2024-26308 (Pack200 OOM), both fixed in 1.26.0. rhino (via
             swagger-request-validator -> json-schema-validator) — CVE-2025-66453 (toFixed DoS),
             fixed in 1.7.15.1. Pinned via explicit dependencyManagement below so they win over the
             imported BOMs. -->
        <commons-compress.version>1.27.1</commons-compress.version>
        <rhino.version>1.7.15.1</rhino.version>
        <!-- Spring Boot 4.1 starter-test transitively depends on JUnit Jupiter 6.0.3, but the
             parent POM manages it to 5.14.3 which lacks computeIfAbsent(Object,Function,Class).
             Override to align with what starter-test expects and what Spring’s test extensions
             are compiled against. -->
        <junit-jupiter.version>6.0.3</junit-jupiter.version>
        <dss.version>6.4</dss.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <shedlock.version>5.16.0</shedlock.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <wiremock.version>3.10.0</wiremock.version>
        <archunit.version>1.3.0</archunit.version>
        <swagger-validator.version>2.43.0</swagger-validator.version>
        <openapi-generator.version>7.10.0</openapi-generator.version>
        <spotless.version>2.44.0</spotless.version>
        <jacoco.version>0.8.12</jacoco.version>
        <sentry.version>8.48.0</sentry.version>
        <!-- logback is pulled in transitively by spring-boot-starter-logging and its version is
             managed by the Spring Boot parent (which defines <logback.version>). Override the
             property to force a patched release past the parent's 1.5.34: CVE-2026-10532
             (object injection via HardenedObjectInputStream, fixed in 1.5.35) is resolved by 1.5.38,
             the current actively-developed release. Safe to bump here because logback-spring.xml
             uses no Janino-based conditional (<if>/<then>/<else>) processing, which 1.5.37 removed. -->
        <logback.version>1.5.38</logback.version>
        <!-- pgjdbc is managed by the Spring Boot parent (postgresql.version=42.7.11). Override the
             property to a patched release: CVE-2026-54291 (silent SCRAM channel-binding downgrade —
             channelBinding=require is not enforced, defeating the MITM protection it promises)
             affects 42.7.4–42.7.11 and is fixed in 42.7.12. Bumped to 42.7.13, the current release. -->
        <postgresql.version>42.7.13</postgresql.version>
        <!-- Jackson 3 (tools.jackson) is managed by the Spring Boot parent, which imports
             tools.jackson:jackson-bom at jackson-bom.version=3.1.4. Override the property to a
             patched release: CVE-2026-59889 (@JsonView bypassed for @JsonUnwrapped container
             properties on deserialization, letting crafted input write fields restricted to a
             higher-privileged view) is fixed in 3.1.5. The Jackson 2.x family carries the same fix
             and is pinned separately to 2.22.1 via the com.fasterxml jackson-bom import below. -->
        <jackson-bom.version>3.1.5</jackson-bom.version>
        <!-- HttpComponents Core 5 is managed by the Spring Boot parent (httpcore5.version=5.4.2),
             which drives both httpcore5 and httpcore5-h2. It reaches the classpath transitively via
             httpclient5 (DSS dss-service and awssdk apache5-client). Override the property to the
             patched 5.4.3, which fixes two remote DoS issues affecting 5.0–5.4.2:
             CVE-2026-54399 (no bound on HTTP header/request-line length in the default config) and
             CVE-2026-54428 (HPackDecoder accepts an unlimited HTTP/2 header list before the
             SETTINGS ACK). -->
        <httpcore5.version>5.4.3</httpcore5.version>
        <!-- HttpComponents Client 5 is managed by the Spring Boot parent (httpclient5.version=5.6.1)
             and pulled in transitively by DSS dss-service and awssdk apache5-client. Override the
             property to a patched release: CVE-2026-64607 (a Content-Encoding decode error leaks the
             connection instead of releasing it, exhausting the pool — affects 5.0.0 onward) is fixed
             in 5.6.3. Bumped to 5.6.4, the current patch on that line. -->
        <httpclient5.version>5.6.4</httpclient5.version>
        <!-- Log4j 2 is managed by the Spring Boot parent (log4j2.version=2.25.4); only log4j-api
             reaches the classpath, via the log4j-to-slf4j bridge that spring-boot-starter-logging
             installs so any Log4j-based library routes through Logback. Override the property to the
             patched 2.25.5: CVE-2026-49844 (MapMessage.asJson() emits non-finite floats as bare NaN /
             Infinity, producing invalid JSON that can corrupt a downstream log pipeline) affects
             2.13.1–2.25.4 and 2.26.0. Staying on the 2.25.x line keeps the diff minimal; 2.26.1 is
             the equivalent fix on the newer line if the parent moves there. -->
        <log4j2.version>2.25.5</log4j2.version>
        <!-- Embedded Tomcat is managed by the Spring Boot parent (tomcat.version=11.0.22) and
             ships as the servlet container via spring-boot-starter-web. Override the property to
             11.0.25, which fixes three advisories affecting 11.0.0-M1 through 11.0.24:
             CVE-2026-65905 (a DIGEST-authenticated request made on the upper boundary of the nonce
             replay window can be replayed once), CVE-2026-65182 (a security constraint on a longer
             path declared before a more restrictive one on a shorter sub-path lets the shorter
             constraint be bypassed) and CVE-2026-68525 (FORM authentication lets a constraint that
             grants POST but not GET on a resource be bypassed). This service authenticates through
             spring-boot-starter-oauth2-resource-server, not Tomcat's DIGEST/FORM authenticators, so
             only the constraint-ordering issue is even theoretically reachable — bumped anyway to
             keep the container free of known criticals. -->
        <tomcat.version>11.0.25</tomcat.version>
        <!-- AWS SDK v2 is NOT managed by the Spring Boot parent; pin the BOM explicitly. Used by
             the S3 DocumentStoragePort adapter (see app.storage.type=s3). -->
        <awssdk.version>2.49.0</awssdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Pin the transitive Jackson 2.x family (dragged onto the compile classpath by
                 springdoc/swagger-core, logstash-logback-encoder, and jackson-databind-nullable)
                 to a patched release. Spring Boot 4.1 manages only Jackson 3 (tools.jackson), so
                 without this override the Jackson 2 on the classpath falls back to the parent-less
                 default 2.21.4, reopening CVE-2026-23183, CVE-2026-54512, CVE-2026-54513 and
                 CVE-2026-54515 (all fixed in 2.22.1). Imported first so it wins. Remove once
                 Jackson 2 is fully off the classpath (see jackson-databind-nullable follow-up). -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.22.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>eu.europa.ec.joinup.sd-dss</groupId>
                <artifactId>dss-bom</artifactId>
                <version>${dss.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.sentry</groupId>
                <artifactId>sentry-bom</artifactId>
                <version>${sentry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Security overrides for vulnerable transitive test deps (see properties above). -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>${commons-compress.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mozilla</groupId>
                <artifactId>rhino</artifactId>
                <version>${rhino.version}</version>
            </dependency>
            <!-- Force JUnit Jupiter 6.0.3: Spring Boot 4.1 starter-test expects it but the parent
                 POM manages it to 5.14.3 which lacks computeIfAbsent(Object,Function,Class). These
                 must be direct dependencyManagement entries, not a junit-bom import: an imported BOM
                 does not override the versions the Spring Boot parent already manages directly, so a
                 junit-bom import silently reverts to 5.14.3 and breaks the test launcher. -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit-jupiter.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit-jupiter.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit-jupiter.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-params</artifactId>
                <version>${junit-jupiter.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-commons</artifactId>
                <version>${junit-jupiter.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-engine</artifactId>
                <version>${junit-jupiter.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-launcher</artifactId>
                <version>${junit-jupiter.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot -->

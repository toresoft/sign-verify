# Copy to .env and fill in before `docker compose -f docker-compose.prod.yml up -d`.
# NEVER commit the real .env (it is git-ignored).

# Immutable image version to deploy (e.g. 1.0.0). Pin it for reproducible deploys and
# unambiguous rollbacks; if unset, the compose file falls back to the mutable :latest tag.
SIGN_VERIFY_VERSION=

# External PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.internal:5432/signverify
SPRING_DATASOURCE_USERNAME=signverify
SPRING_DATASOURCE_PASSWORD=change-me

# Secret encryption master key — base64-encoded 32 bytes (256-bit).
# Generate with:  openssl rand -base64 32
APP_SECRET_MASTER_KEY=

# OAuth2 / OIDC issuer (required when app.security.oauth.enabled=true, the default)
APP_SECURITY_OAUTH_ISSUER_URI=https://idp.example.com/realms/signverify

# Password for the EU Official Journal keystore bundled in the image
APP_OJ_KEYSTORE_PASSWORD=

# Sentry error tracking (optional — leave SENTRY_DSN empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Release identifier for Sentry. Use the git tag (e.g. 1.2.3); leave empty to let the SDK auto-detect.
SENTRY_RELEASE=
# Minimum log level captured as Sentry breadcrumbs (INFO/WARN/ERROR). Use WARN to reduce quota.
SENTRY_BREADCRUMB_LEVEL=INFO

# --- OTLP metrics export (optional) ---
# Push metrics to an OpenTelemetry Collector over OTLP/HTTP. Off by default; the
# Prometheus scrape endpoint at /actuator/prometheus stays available either way.
# Try it locally with:  docker run --rm -p 4318:4318 otel/opentelemetry-collector
#APP_METRICS_OTLP_ENABLED=true
#APP_METRICS_OTLP_URL=http://otel-collector:4318/v1/metrics
#APP_METRICS_OTLP_STEP=60s
